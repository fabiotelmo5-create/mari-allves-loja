# Supabase (região São Paulo recomendada)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anona
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Banco de dados (Prisma)
DATABASE_URL="postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres"

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mari Allves — Moda Modesta"

# Pagamento
# manual = combinar com a loja; mercado_pago = Checkout Pro
PAYMENT_PROVIDER=manual
# Checkout Pro: access token (produção ou teste) e segredo do webhook.
# A chave pública não é usada pelo Checkout Pro; fica para checkout transparente futuro.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# true somente com credenciais de teste
MERCADO_PAGO_SANDBOX=false
# Opcional, apenas para testes locais com mock. Deixe vazio em produção.
MERCADO_PAGO_API_BASE=

# E-mail transacional (Resend/SendGrid)
RESEND_API_KEY=
EMAIL_FROM="Mari Allves <nao-responda@seudominio.com.br>"

# Segredos
NEXTAUTH_SECRET=gerar-um-segredo-forte
ADMIN_SETUP_TOKEN=token-seguro-para-primeiro-admin

# Rate limiting (Upstash Redis — opcional no dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
