{
  "name": "mari-allves",
  "private": true,
  "description": "Mari Allves — Moda Modesta — Loja virtual completa",
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/db",
    "packages/ui"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "db:generate": "pnpm --filter db prisma generate",
    "db:push": "pnpm --filter db prisma db push",
    "db:migrate": "pnpm --filter db prisma migrate dev",
    "db:studio": "pnpm --filter db prisma studio",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
